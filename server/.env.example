# ---------------------------------------------------------------------------
# TrailAsia API — example environment file
# Copy to .env and fill in real values. Never commit .env.
#   cp .env.example .env      (Windows: copy .env.example .env)
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Origin allowed to send credentialed requests. Must match the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173
# Where travellers sign in. Set to TrailAsia Book's address and portal
# invitation links (emailed and shown to staff) open its /activate page.
# Blank = the traveller screens built into the staff client at /trip.
#   development: TRAVELLER_PORTAL_URL=http://localhost:5174
TRAVELLER_PORTAL_URL=
LOG_LEVEL=dev

# --- MySQL -----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trailasia
DB_USER=trailasia_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
# Set true when connecting to a managed MySQL instance that requires TLS
DB_SSL=false

# --- Authentication --------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
# Refresh tokens are opaque random strings stored hashed; rotated on every use.
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=trailasia_rt
# Travellers get their own cookie name and path, so one session cannot overwrite the
# other in a browser signed in to both. Defaults to <REFRESH_COOKIE_NAME>_traveller.
TRAVELLER_REFRESH_COOKIE_NAME=
# How long a traveller's portal invitation stays usable.
PORTAL_INVITE_TTL_HOURS=72
BCRYPT_SALT_ROUNDS=12
# Per-account lockout after repeated failed sign-ins
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Seeded staff accounts (used by `npm run db:seed`) ----------------------
# One account per role, so you can sign in as each and see how the interface
# differs. Leave these blank for local development and the seeder falls back to
# admin@trailasia.local / coordinator@… / consultant@… / finance@…, all with the
# password `trailasia-dev-password`.
#
# Those defaults are REFUSED when NODE_ENV=production — set real values below,
# or a single SEED_DEFAULT_PASSWORD, before deploying anywhere.
# Minimum 12 characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_COORDINATOR_EMAIL=
SEED_COORDINATOR_PASSWORD=
SEED_CONSULTANT_EMAIL=
SEED_CONSULTANT_PASSWORD=
SEED_FINANCE_EMAIL=
SEED_FINANCE_PASSWORD=
# Fallback password for any of the four that has none of its own
SEED_DEFAULT_PASSWORD=

# --- Payments (PCI DSS: the API never stores full card numbers) -------------
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
DEFAULT_CURRENCY=AUD
# How many days before an instalment's due date it starts showing up in the
# "due soon" reminder sweep (server/src/jobs/paymentReminders.js).
PAYMENT_REMINDER_LEAD_DAYS=7

# --- Public booking enquiries (TrailAsia Book) ------------------------------
# Who a booking enquiry submitted through the public site lands with. Leave
# blank and it falls back to the first active consultant, then the first
# active admin, at request time.
PUBLIC_ENQUIRY_CONSULTANT_ID=
# Per-IP ceiling on the public enquiry form — the only brake available, since
# there is no account to apply a per-account lockout to.
PUBLIC_ENQUIRY_RATE_LIMIT_MAX=10
PUBLIC_ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=15

# --- Email (Mailgun) --------------------------------------------------------
# Leave both blank for local development — mailer.service.js logs what it
# would have sent instead of calling Mailgun, so the app runs with no mail
# account at all. Fill both in to turn on real email: portal invite links,
# and a copy of every in-app notification (see notification.service.js).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="TrailAsia <no-reply@trailasia.example>"

# --- Traveller safety module ----------------------------------------------
# Retention window for location pings, in days after trip end (APP 11 / Privacy Act 1988)
LOCATION_RETENTION_DAYS=30
# Pings closer together than this are folded into the previous one rather than stored.
MIN_PING_INTERVAL_SECONDS=30
SOS_ESCALATION_EMAIL=

# --- File uploads (passports, visas, insurance, health declarations) --------
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=application/pdf,image/png,image/jpeg
