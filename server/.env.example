# ---------------------------------------------------------------------------
# TrailAsia API — example environment file
# Copy to .env and fill in real values. Never commit .env.
#   cp .env.example .env      (Windows: copy .env.example .env)
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Origin allowed to send credentialed requests. Must match the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=dev

# --- MySQL -----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trailasia
DB_USER=trailasia_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
# Set true when connecting to a managed MySQL instance that requires TLS
DB_SSL=false

# --- Authentication --------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
# Refresh tokens are opaque random strings stored hashed; rotated on every use.
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=trailasia_rt
BCRYPT_SALT_ROUNDS=12
# Per-account lockout after repeated failed sign-ins
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- First administrator (used by `npm run db:seed`) ------------------------
# Minimum 12 characters. Change the password after the first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Payments (PCI DSS: the API never stores full card numbers) -------------
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
DEFAULT_CURRENCY=AUD

# --- Email / notifications -------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="TrailAsia <no-reply@trailasia.example>"

# --- Traveller safety module ----------------------------------------------
# Retention window for location pings, in days after trip end (APP 11 / Privacy Act 1988)
LOCATION_RETENTION_DAYS=30
SOS_ESCALATION_EMAIL=

# --- File uploads (passports, visas, insurance, health declarations) --------
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=application/pdf,image/png,image/jpeg
