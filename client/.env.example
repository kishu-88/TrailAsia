# ---------------------------------------------------------------------------
# TrailAsia web client — example environment file
# Copy to .env.local and fill in. Vite only exposes vars prefixed with VITE_.
#
# WARNING: anything here ships to the browser. No secrets, ever.
# ---------------------------------------------------------------------------

# Relative by default: the Vite dev server proxies /api to http://localhost:4000
# (see vite.config.js), so the browser sees a single origin and the httpOnly
# refresh cookie behaves exactly as it will in production.
# Point this at an absolute URL only if the API is on a different host.
VITE_API_BASE_URL=/api/v1

VITE_APP_NAME=TrailAsia
VITE_DEFAULT_CURRENCY=AUD

# Feature flags — keep release-1 scope switchable during the pilot
VITE_FEATURE_SAFETY_MODULE=true
VITE_FEATURE_FAIR_PRICE_GUIDE=true
VITE_FEATURE_CHATBOT=false

# Publishable (non-secret) payment gateway key
VITE_PAYMENT_PUBLIC_KEY=
